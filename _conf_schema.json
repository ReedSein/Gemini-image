{
    "vertex_project": {
        "description": "Vertex AI 项目 ID",
        "type": "string",
        "hint": "你的 Google Cloud Platform (GCP) 项目ID。认证需设置 GOOGLE_APPLICATION_CREDENTIALS 环境变量。",
        "obvious_hint": true,
        "default": ""
    },
    "vertex_location": {
        "description": "Vertex AI 模型所在区域",
        "type": "string",
        "hint": "你的模型部署的 GCP 区域，例如 'us-central1' 或 'global'。",
        "obvious_hint": true,
        "default": ""
    },
    "api_key": {
        "description": "Vertex AI Key / AI Studio Key",
        "type": "string",
        "hint": "Key",
        "obvious_hint": true,
        "default": ""
    },
    "api_backend_default": {
        "description": "默认 API 后端",
        "type": "string",
        "hint": "可选：google/openai/zai/grok2api/doubao",
        "default": "google",
        "options": ["google", "openai", "zai", "grok2api", "doubao"]
    },
    "vertex_enabled": {
        "description": "Google 后端是否启用 Vertex 模式",
        "type": "bool",
        "hint": "仅在当前后端为 google 时生效；关闭后使用 AI Studio API Key 模式。",
        "default": true
    },
    "backend_settings": {
        "description": "多后端配置",
        "type": "object",
        "items": {
            "google": {
                "description": "Google 后端配置",
                "type": "object",
                "items": {
                    "model": {
                        "description": "模型名（可选）",
                        "type": "string",
                        "default": ""
                    },
                    "api_key": {
                        "description": "Google API Key（可选，留空回退全局 api_key）",
                        "type": "string",
                        "default": ""
                    },
                    "api_base": {
                        "description": "Google API Base（可选）",
                        "type": "string",
                        "default": ""
                    }
                }
            },
            "openai": {
                "description": "OpenAI 兼容后端配置",
                "type": "object",
                "items": {
                    "model": {
                        "description": "模型名",
                        "type": "string",
                        "default": "gemini-3-pro-image-preview"
                    },
                    "api_key": {
                        "description": "OpenAI API Key",
                        "type": "string",
                        "default": ""
                    },
                    "api_base": {
                        "description": "OpenAI API Base",
                        "type": "string",
                        "default": "https://api.openai.com/v1"
                    }
                }
            },
            "zai": {
                "description": "Zai 后端配置",
                "type": "object",
                "items": {
                    "model": {
                        "description": "模型名",
                        "type": "string",
                        "default": "gemini-3-pro-image-preview"
                    },
                    "api_key": {
                        "description": "Zai API Key",
                        "type": "string",
                        "default": ""
                    },
                    "api_base": {
                        "description": "Zai API Base",
                        "type": "string",
                        "default": ""
                    }
                }
            },
            "grok2api": {
                "description": "grok2api 后端配置",
                "type": "object",
                "items": {
                    "model": {
                        "description": "模型名",
                        "type": "string",
                        "default": "gemini-3-pro-image-preview"
                    },
                    "api_key": {
                        "description": "grok2api API Key",
                        "type": "string",
                        "default": ""
                    },
                    "api_base": {
                        "description": "grok2api API Base",
                        "type": "string",
                        "default": ""
                    }
                }
            },
            "doubao": {
                "description": "Doubao 后端配置",
                "type": "object",
                "items": {
                    "endpoint_id": {
                        "description": "模型/Endpoint ID",
                        "type": "string",
                        "default": "doubao-seedream-4-5-251128"
                    },
                    "api_key": {
                        "description": "Doubao API Key",
                        "type": "string",
                        "default": ""
                    },
                    "api_base": {
                        "description": "Doubao API Base",
                        "type": "string",
                        "default": "https://ark.cn-beijing.volces.com"
                    },
                    "default_size": {
                        "description": "默认尺寸",
                        "type": "string",
                        "default": "2K",
                        "options": ["2K", "4K"]
                    },
                    "watermark": {
                        "description": "是否添加水印",
                        "type": "bool",
                        "default": false
                    }
                }
            }
        }
    },
    "auth_json_path": {
        "description": "GCP 认证 JSON 文件路径 (可选)",
        "type": "string",
        "hint": "如果设置环境变量不方便，可在此直接填写 auth.json 文件的绝对路径。",
        "default": ""
    },
    "vertex_auth_json": {
        "description": "GCP 认证 JSON 内容 (备用)",
        "type": "string",
        "hint": "直接粘贴 service account json 的完整内容。若未填写路径配置，将自动生成临时文件使用。",
        "default": ""
    },
    "model_name": {
        "description": "旧版默认模型 (兼容字段)",
        "type": "string",
        "hint": "当 model_map.flash 未设置时，此值作为 flash 模型后备。",
        "default": "gemini-2.5-flash-image"
    },
    "model_map": {
        "description": "imago 子命令模型映射",
        "type": "object",
        "items": {
            "flash": {
                "description": "flash 子命令模型名",
                "type": "string",
                "default": "gemini-2.5-flash-image"
            },
            "pro": {
                "description": "pro 子命令模型名",
                "type": "string",
                "default": "gemini-3-pro-image-preview"
            }
        }
    },
    "system_instruction": {
        "description": "【核心】系统提示词 (System Instruction)",
        "type": "text",
        "editor_mode": true,
        "hint": "全局生效。用于设定模型的行为准则、安全限制或画风偏好。",
        "default": "你是一个专业的AI绘图助手。请根据用户的描述生成高质量的图片。如果用户请求包含敏感、色情或暴力的内容，请拒绝生成并礼貌告知。"
    },
    "feedback": {
        "description": "【交互】消息反馈设置",
        "type": "object",
        "items": {
            "draw_start": {
                "description": "生图开始时发送提示",
                "type": "bool",
                "default": true
            },
            "draw_start_text": {
                "description": "生图提示语文案",
                "type": "text",
                "default": "OK，正在{mode} (模型: {model}，预计消耗 {cost} 积分)...",
                "hint": "可用变量: {mode}(文/图生图), {model}(模型名), {cost}(消耗积分)"
            },
            "menu_start": {
                "description": "菜单渲染时发送提示",
                "type": "bool",
                "default": true
            }
        }
    },
    "save_image": {
        "description": "是否保存生成的图片",
        "type": "bool",
        "default": true
    },
    "incantation_fallback_reply": {
        "description": "咒语生图失败兜底回复",
        "type": "string",
        "hint": "当咒语触发生图失败时发送的兜底文本（前台不输出其它提示）。",
        "default": "咒语生图失败，请稍后再试。"
    },
    "proxy_enabled": {
        "description": "是否启用代理",
        "type": "bool",
        "default": true
    },
    "proxy_url": {
        "description": "代理地址",
        "type": "string",
        "hint": "例如 socks5://127.0.0.1:23344，留空则不使用代理。",
        "default": ""
    },
    "admin_id": {
        "description": "管理员QQ号",
        "type": "string",
        "hint": "免除配额和积分限制的用户ID",
        "default": ""
    },
    "rate_limits": {
        "description": "【风控】频率限制配置",
        "type": "object",
        "items": {
            "flash_rpm": {
                "description": "Flash 模型每分钟最大请求数",
                "type": "int",
                "default": 3
            },
            "pro_cooldown": {
                "description": "Pro 模型冷却时间 (秒)",
                "type": "int",
                "default": 90
            }
        }
    },
    "quota": {
        "description": "【风控】每日总次数配额",
        "type": "object",
        "items": {
            "flash": {
                "description": "Flash 模型每日上限",
                "type": "int",
                "default": 50
            },
            "pro": {
                "description": "Pro 模型每日上限",
                "type": "int",
                "default": 10
            }
        }
    },
    "generation_timeout_seconds": {
        "description": "生图超时时间（秒），超时后取消任务并释放队列",
        "type": "int",
        "default": 90,
        "minimum": 10
    },
    "economy": {
        "description": "【经济系统】积分与签到配置",
        "type": "object",
        "items": {
            "enabled": {
                "description": "是否开启积分系统",
                "type": "bool",
                "default": true
            },
            "cost_flash": {
                "description": "Flash 模型单次消耗积分",
                "type": "int",
                "default": 10
            },
            "cost_pro": {
                "description": "Pro 模型单次消耗积分",
                "type": "int",
                "default": 50
            },
            "checkin_min": {
                "description": "签到奖励最小值",
                "type": "int",
                "default": 20
            },
            "checkin_max": {
                "description": "签到奖励最大值",
                "type": "int",
                "default": 100
            },
            "redeem_codes": {
                "description": "兑换码列表",
                "type": "list",
                "default": ["GEMINI2025:100", "WELCOME:50"],
                "hint": "格式 '兑换码:积分'。例如 'VIP888:1000'。每个码每个用户限用一次。",
                "items": { "type": "string" }
            }
        }
    },
    "base_prompts": {
        "description": "通用提示词前缀 (Base Prompts)",
        "type": "object",
        "items": {
            "text_to_image_base_prompt": {
                "description": "文生图前缀",
                "type": "text",
                "editor_mode": true,
                "default": "Create a image based on the following description."
            },
            "image_to_image_base_prompt": {
                "description": "图生图前缀",
                "type": "text",
                "editor_mode": true,
                "default": "Using the provided image as a reference, redraw it according to the following instructions. "
            }
        }
    },
    "style_presets": {
        "description": "【风格】预设列表",
        "type": "list",
        "hint": "格式：预设名:提示词内容。支持使用 \\n 换行。使用 /imago <预设名> 调用。",
        "default": [
            "手办化:Your task is to create a photorealistic, masterpiece-quality image of a 1/7 scale commercialized figurine based on the user's character. The final image must be in a realistic style and environment. The figurine's face is the most critical element. It must be a perfect, high-fidelity 3D translation of the character. Scene Composition: Place the figure on a computer desk with a simple circular transparent acrylic base.",
            "Q版化:((chibi style)), ((super-deformed)), ((head-to-body ratio 1:2)), ((huge head, tiny body)), ((smooth rounded limbs)), ((soft balloon-like hands and feet)), ((plump cheeks)), ((childlike big eyes)), ((simplified facial features)), ((soft pastel color palette)), ((gentle ambient lighting)).",
            "痛屋化:[ABSOLUTE PRIORITY] Based on the provided reference image, generate a hyper-detailed photograph of a maximalist otaku shrine. All character-related elements—including figures, posters, bedding patterns—must be a 90%+ faithful replication of the character in the reference image.",
            "痛车化:A Xiaomi SU7 electric sedan with a professional 'itasha' wrap, parked on a rain-slicked, neon-lit city street at dusk. The entire car is covered in a vibrant, high-resolution decal featuring multiple dynamic poses and expressions of ONLY the provided anime character.",
            "穿搭拆解:A professional e-commerce fashion showcase featuring the clothing worn by the character from the input image, presented in a clean, studio-style setting. The outfit is decomposed into individual pieces (e.g., top, bottom, jacket, shoes, accessories), arranged in an organized layout.",
            "三视图:a 3-view orthographic drawing of a young woman from a photo, showing front, right side, and back views. Realistic rendering, professional character sheet style, on a white background",
            "拆解图:Convert the people in the photos to the style of a model kit box, rendered in isometric perspective. Label the box with the title“Zhogue”. Inside the box, a gouda-styled robotic version of the person is displayed along with essentials redesigned as futuristic mechanical accessories.",
            "像素:Convert this image into 16-bit pixel art style, high detail, retro aesthetic.",
            "乐高:Transform the subject into a LEGO brick model, realistic lego texture, studio lighting."
        ],
        "items": {
            "type": "string"
        }
    }
}
